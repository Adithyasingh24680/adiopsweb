<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- ── Full-screen preview ──────────────────────────────────────────── -->
    <TextureView
        android:id="@+id/textureView"
        android:layout_width="0dp" android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <com.adiopsweb.camera.ui.OverlayView
        android:id="@+id/overlayView"
        android:layout_width="0dp" android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Capture flash -->
    <View android:id="@+id/captureFlash"
        android:layout_width="0dp" android:layout_height="0dp"
        android:background="#FFFFFFFF" android:alpha="0.85" android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" />

    <!-- ══ TOP BAR ══════════════════════════════════════════════════════════ -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="0dp" android:layout_height="52dp"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:paddingStart="8dp" android:paddingEnd="8dp"
        android:background="#CC000000"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <Button android:id="@+id/btnFlash"
            style="@style/Widget.AppCompat.Button.Borderless"
            android:layout_width="44dp" android:layout_height="44dp"
            android:text="⚡" android:textSize="17sp" android:textColor="#66FFFFFF"
            android:minWidth="0dp" android:padding="0dp" />

        <Button android:id="@+id/btnHdr"
            style="@style/Widget.AppCompat.Button.Borderless"
            android:layout_width="wrap_content" android:layout_height="44dp"
            android:text="HDR" android:textColor="#66FFFFFF" android:textSize="10sp"
            android:letterSpacing="0.08" android:minWidth="0dp"
            android:paddingStart="6dp" android:paddingEnd="6dp" />

        <Button android:id="@+id/btnRaw"
            style="@style/Widget.AppCompat.Button.Borderless"
            android:layout_width="wrap_content" android:layout_height="44dp"
            android:text="JPG" android:textColor="#66FFFFFF" android:textSize="10sp"
            android:letterSpacing="0.08" android:minWidth="0dp"
            android:paddingStart="6dp" android:paddingEnd="6dp" />

        <!-- Grid type cycle button -->
        <Button android:id="@+id/btnGridType"
            style="@style/Widget.AppCompat.Button.Borderless"
            android:layout_width="wrap_content" android:layout_height="44dp"
            android:text="GRID" android:textColor="#66FFFFFF" android:textSize="10sp"
            android:letterSpacing="0.05" android:minWidth="0dp"
            android:paddingStart="6dp" android:paddingEnd="6dp" />

        <!-- Histogram toggle -->
        <Button android:id="@+id/btnHistogram"
            style="@style/Widget.AppCompat.Button.Borderless"
            android:layout_width="wrap_content" android:layout_height="44dp"
            android:text="HIST" android:textColor="#66FFFFFF" android:textSize="10sp"
            android:letterSpacing="0.05" android:minWidth="0dp"
            android:paddingStart="6dp" android:paddingEnd="6dp" />

        <View android:layout_width="0dp" android:layout_height="0dp" android:layout_weight="1" />

        <!-- Recording timer -->
        <TextView android:id="@+id/tvRecordTimer"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="00:00" android:textColor="#FFFF2020" android:textSize="12sp"
            android:fontFamily="monospace" android:visibility="gone"
            android:layout_marginEnd="6dp" />

        <!-- Recording dot -->
        <View android:id="@+id/recordingIndicator"
            android:layout_width="8dp" android:layout_height="8dp"
            android:background="#FFFF2020" android:visibility="gone"
            android:layout_marginEnd="6dp" />

        <Button android:id="@+id/btnMenu"
            style="@style/Widget.AppCompat.Button.Borderless"
            android:layout_width="44dp" android:layout_height="44dp"
            android:text="≡" android:textColor="#66FFFFFF" android:textSize="20sp"
            android:minWidth="0dp" android:padding="0dp" />
    </LinearLayout>

    <!-- Zoom pill -->
    <TextView android:id="@+id/tvZoomLevel"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="1.0×" android:textColor="#FFFFFFFF" android:textSize="13sp"
        android:background="#88000000"
        android:paddingStart="14dp" android:paddingEnd="14dp"
        android:paddingTop="5dp" android:paddingBottom="5dp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/topBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="10dp" />

    <!-- ══ PORTRAIT DOF BAR (portrait mode only) ════════════════════════════ -->
    <LinearLayout android:id="@+id/portraitPanel"
        android:layout_width="0dp" android:layout_height="48dp"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:paddingStart="20dp" android:paddingEnd="20dp"
        android:background="#CC000000" android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/lensSelector"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="BLUR" android:textColor="#88FFFFFF" android:textSize="10sp"
            android:letterSpacing="0.08" android:layout_marginEnd="8dp" />
        <SeekBar android:id="@+id/seekbarBokeh"
            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:max="100" android:progress="50"
            android:progressTint="#FFFF8000" android:thumbTint="#FFFF8000" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="OFF" android:textColor="#88FFFFFF" android:textSize="10sp"
            android:letterSpacing="0.08" android:layout_marginStart="8dp" />
    </LinearLayout>

    <!-- ══ ASPECT RATIO BAR ═════════════════════════════════════════════════ -->
    <LinearLayout android:id="@+id/aspectRatioBar"
        android:layout_width="0dp" android:layout_height="30dp"
        android:orientation="horizontal" android:gravity="center"
        android:background="#99000000"
        app:layout_constraintBottom_toTopOf="@id/lensSelector"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <Button android:id="@+id/btnRatioFull" style="@style/Widget.AppCompat.Button.Borderless"
            android:layout_width="wrap_content" android:layout_height="match_parent"
            android:text="FULL" android:textColor="#FFFF8000" android:textSize="9sp"
            android:letterSpacing="0.06" android:minWidth="0dp"
            android:paddingStart="14dp" android:paddingEnd="14dp" />
        <View android:layout_width="1dp" android:layout_height="12dp" android:background="#33FFFFFF"
            android:layout_marginStart="2dp" android:layout_marginEnd="2dp" />
        <Button android:id="@+id/btnRatioWide" style="@style/Widget.AppCompat.Button.Borderless"
            android:layout_width="wrap_content" android:layout_height="match_parent"
            android:text="16:9" android:textColor="#88FFFFFF" android:textSize="9sp"
            android:letterSpacing="0.06" android:minWidth="0dp"
            android:paddingStart="14dp" android:paddingEnd="14dp" />
        <View android:layout_width="1dp" android:layout_height="12dp" android:background="#33FFFFFF"
            android:layout_marginStart="2dp" android:layout_marginEnd="2dp" />
        <Button android:id="@+id/btnRatioStandard" style="@style/Widget.AppCompat.Button.Borderless"
            android:layout_width="wrap_content" android:layout_height="match_parent"
            android:text="4:3" android:textColor="#88FFFFFF" android:textSize="9sp"
            android:letterSpacing="0.06" android:minWidth="0dp"
            android:paddingStart="14dp" android:paddingEnd="14dp" />
        <View android:layout_width="1dp" android:layout_height="12dp" android:background="#33FFFFFF"
            android:layout_marginStart="2dp" android:layout_marginEnd="2dp" />
        <Button android:id="@+id/btnRatioSquare" style="@style/Widget.AppCompat.Button.Borderless"
            android:layout_width="wrap_content" android:layout_height="match_parent"
            android:text="1:1" android:textColor="#88FFFFFF" android:textSize="9sp"
            android:letterSpacing="0.06" android:minWidth="0dp"
            android:paddingStart="14dp" android:paddingEnd="14dp" />
    </LinearLayout>

    <!-- ══ MANUAL SLIDER PANEL (slides up when a chip is tapped) ════════════ -->
    <LinearLayout android:id="@+id/sliderPanel"
        android:layout_width="0dp" android:layout_height="52dp"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:paddingStart="16dp" android:paddingEnd="16dp"
        android:background="#EE000000" android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/controlStrip"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView android:id="@+id/tvSliderLabel"
            android:layout_width="72dp" android:layout_height="wrap_content"
            android:text="ISO" android:textColor="#88FFFFFF" android:textSize="9sp"
            android:letterSpacing="0.1" />

        <SeekBar android:id="@+id/sliderControl"
            android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1"
            android:progressTint="#FFFF8000" android:thumbTint="#FFFF8000"
            android:layout_marginEnd="12dp" />

        <TextView android:id="@+id/tvSliderValue"
            android:layout_width="80dp" android:layout_height="wrap_content"
            android:text="Auto" android:textColor="#FFFF8000" android:textSize="13sp"
            android:gravity="end" android:textStyle="bold" />
    </LinearLayout>

    <!-- ══ LENS SELECTOR ════════════════════════════════════════════════════ -->
    <LinearLayout android:id="@+id/lensSelector"
        android:layout_width="0dp" android:layout_height="44dp"
        android:orientation="horizontal" android:gravity="center"
        android:background="#CC000000"
        app:layout_constraintBottom_toTopOf="@id/sliderPanel"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <Button android:id="@+id/btnLensUltrawide"
            style="@style/Widget.AppCompat.Button.Borderless"
            android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
            android:text="0.6×" android:textColor="#88FFFFFF" android:textSize="12sp"
            android:minWidth="0dp" />
        <Button android:id="@+id/btnLensWide"
            style="@style/Widget.AppCompat.Button.Borderless"
            android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
            android:text="1×" android:textColor="#FFFF8000" android:textSize="14sp"
            android:textStyle="bold" android:minWidth="0dp" />
        <Button android:id="@+id/btnLensTele"
            style="@style/Widget.AppCompat.Button.Borderless"
            android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
            android:text="3×" android:textColor="#88FFFFFF" android:textSize="12sp"
            android:minWidth="0dp" />
    </LinearLayout>

    <!-- ══ UNIFIED CONTROL STRIP (always visible, horizontal scroll) ════════
         Each chip shows current value and cycles through options on tap.
         Organised: ISO · SS · WB · EV · FOCUS · PROFILE | RES · FPS · STAB
    ═══════════════════════════════════════════════════════════════════════════ -->
    <HorizontalScrollView
        android:id="@+id/controlStrip"
        android:layout_width="0dp"
        android:layout_height="68dp"
        android:scrollbars="none"
        android:background="#E6000000"
        android:fillViewport="false"
        app:layout_constraintBottom_toTopOf="@id/modeTabBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="12dp"
            android:paddingEnd="12dp">

            <!-- ISO -->
            <LinearLayout android:layout_width="60dp" android:layout_height="54dp"
                android:orientation="vertical" android:gravity="center"
                android:background="#1AFFFFFF" android:layout_marginEnd="6dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="ISO" android:textColor="#88FFFFFF" android:textSize="8sp"
                    android:letterSpacing="0.1" />
                <Button android:id="@+id/btnCtrlIso"
                    style="@style/Widget.AppCompat.Button.Borderless"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Auto" android:textColor="#FFFF8000" android:textSize="11sp"
                    android:minWidth="0dp" android:padding="0dp" />
            </LinearLayout>

            <!-- Shutter Speed -->
            <LinearLayout android:layout_width="68dp" android:layout_height="54dp"
                android:orientation="vertical" android:gravity="center"
                android:background="#1AFFFFFF" android:layout_marginEnd="6dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="SHUTTER" android:textColor="#88FFFFFF" android:textSize="8sp"
                    android:letterSpacing="0.1" />
                <Button android:id="@+id/btnCtrlShutter"
                    style="@style/Widget.AppCompat.Button.Borderless"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Auto" android:textColor="#FFFF8000" android:textSize="11sp"
                    android:minWidth="0dp" android:padding="0dp" />
            </LinearLayout>

            <!-- White Balance -->
            <LinearLayout android:layout_width="60dp" android:layout_height="54dp"
                android:orientation="vertical" android:gravity="center"
                android:background="#1AFFFFFF" android:layout_marginEnd="6dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="W.BAL" android:textColor="#88FFFFFF" android:textSize="8sp"
                    android:letterSpacing="0.1" />
                <Button android:id="@+id/btnCtrlWb"
                    style="@style/Widget.AppCompat.Button.Borderless"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Auto" android:textColor="#FFFF8000" android:textSize="11sp"
                    android:minWidth="0dp" android:padding="0dp" />
            </LinearLayout>

            <!-- EV -->
            <LinearLayout android:layout_width="56dp" android:layout_height="54dp"
                android:orientation="vertical" android:gravity="center"
                android:background="#1AFFFFFF" android:layout_marginEnd="6dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="EV" android:textColor="#88FFFFFF" android:textSize="8sp"
                    android:letterSpacing="0.1" />
                <Button android:id="@+id/btnCtrlEv"
                    style="@style/Widget.AppCompat.Button.Borderless"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="0" android:textColor="#FFFF8000" android:textSize="11sp"
                    android:minWidth="0dp" android:padding="0dp" />
            </LinearLayout>

            <!-- Focus -->
            <LinearLayout android:layout_width="60dp" android:layout_height="54dp"
                android:orientation="vertical" android:gravity="center"
                android:background="#1AFFFFFF" android:layout_marginEnd="6dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="FOCUS" android:textColor="#88FFFFFF" android:textSize="8sp"
                    android:letterSpacing="0.1" />
                <Button android:id="@+id/btnCtrlFocus"
                    style="@style/Widget.AppCompat.Button.Borderless"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="C-AF" android:textColor="#FFFF8000" android:textSize="11sp"
                    android:minWidth="0dp" android:padding="0dp" />
            </LinearLayout>

            <!-- Color Profile -->
            <LinearLayout android:layout_width="60dp" android:layout_height="54dp"
                android:orientation="vertical" android:gravity="center"
                android:background="#1AFFFFFF" android:layout_marginEnd="6dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="PROFILE" android:textColor="#88FFFFFF" android:textSize="8sp"
                    android:letterSpacing="0.1" />
                <Button android:id="@+id/btnCtrlProfile"
                    style="@style/Widget.AppCompat.Button.Borderless"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Nat" android:textColor="#FFFF8000" android:textSize="11sp"
                    android:minWidth="0dp" android:padding="0dp" />
            </LinearLayout>

            <!-- Divider -->
            <View android:layout_width="1dp" android:layout_height="36dp"
                android:background="#33FFFFFF" android:layout_marginEnd="6dp" />

            <!-- Resolution -->
            <LinearLayout android:layout_width="64dp" android:layout_height="54dp"
                android:orientation="vertical" android:gravity="center"
                android:background="#1AFFFFFF" android:layout_marginEnd="6dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="RES" android:textColor="#88FFFFFF" android:textSize="8sp"
                    android:letterSpacing="0.1" />
                <Button android:id="@+id/btnCtrlRes"
                    style="@style/Widget.AppCompat.Button.Borderless"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="1080p" android:textColor="#FFFF8000" android:textSize="11sp"
                    android:minWidth="0dp" android:padding="0dp" />
            </LinearLayout>

            <!-- Frame Rate -->
            <LinearLayout android:layout_width="56dp" android:layout_height="54dp"
                android:orientation="vertical" android:gravity="center"
                android:background="#1AFFFFFF" android:layout_marginEnd="6dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="FPS" android:textColor="#88FFFFFF" android:textSize="8sp"
                    android:letterSpacing="0.1" />
                <Button android:id="@+id/btnCtrlFps"
                    style="@style/Widget.AppCompat.Button.Borderless"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="30" android:textColor="#FFFF8000" android:textSize="11sp"
                    android:minWidth="0dp" android:padding="0dp" />
            </LinearLayout>

            <!-- Stabilization -->
            <LinearLayout android:layout_width="56dp" android:layout_height="54dp"
                android:orientation="vertical" android:gravity="center"
                android:background="#1AFFFFFF" android:layout_marginEnd="6dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="STAB" android:textColor="#88FFFFFF" android:textSize="8sp"
                    android:letterSpacing="0.1" />
                <Button android:id="@+id/btnCtrlStab"
                    style="@style/Widget.AppCompat.Button.Borderless"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="ON" android:textColor="#FFFF8000" android:textSize="11sp"
                    android:minWidth="0dp" android:padding="0dp" />
            </LinearLayout>

            <!-- Level indicator toggle -->
            <LinearLayout android:layout_width="56dp" android:layout_height="54dp"
                android:orientation="vertical" android:gravity="center"
                android:background="#1AFFFFFF" android:layout_marginEnd="6dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="LEVEL" android:textColor="#88FFFFFF" android:textSize="8sp"
                    android:letterSpacing="0.1" />
                <Button android:id="@+id/btnCtrlLevel"
                    style="@style/Widget.AppCompat.Button.Borderless"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="ON" android:textColor="#FFFF8000" android:textSize="11sp"
                    android:minWidth="0dp" android:padding="0dp" />
            </LinearLayout>

        </LinearLayout>
    </HorizontalScrollView>

    <!-- ══ MODE TABS ════════════════════════════════════════════════════════ -->
    <LinearLayout android:id="@+id/modeTabBar"
        android:layout_width="0dp" android:layout_height="38dp"
        android:orientation="horizontal" android:gravity="center"
        android:background="#CC000000"
        app:layout_constraintBottom_toTopOf="@id/bottomBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <Button android:id="@+id/tabPro" style="@style/Widget.AppCompat.Button.Borderless"
            android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
            android:text="PRO" android:textColor="#FFFF8000" android:textSize="11sp"
            android:letterSpacing="0.08" android:minWidth="0dp" />
        <Button android:id="@+id/tabCine" style="@style/Widget.AppCompat.Button.Borderless"
            android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
            android:text="CINE" android:textColor="#55FFFFFF" android:textSize="11sp"
            android:letterSpacing="0.08" android:minWidth="0dp" />
    </LinearLayout>

    <!-- ══ SHUTTER BAR ══════════════════════════════════════════════════════ -->
    <LinearLayout android:id="@+id/bottomBar"
        android:layout_width="0dp" android:layout_height="100dp"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:background="#CC000000"
        android:paddingStart="28dp" android:paddingEnd="28dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView android:id="@+id/ivGallery"
            android:layout_width="52dp" android:layout_height="52dp"
            android:background="#22FFFFFF" android:scaleType="centerCrop"
            android:src="@android:drawable/ic_menu_slideshow"
            android:contentDescription="Gallery" />

        <View android:layout_width="0dp" android:layout_height="0dp" android:layout_weight="1" />

        <ImageButton android:id="@+id/btnCapture"
            android:layout_width="76dp" android:layout_height="76dp"
            android:background="@drawable/shutter_button_bg"
            android:src="@drawable/ic_shutter"
            android:scaleType="center"
            android:contentDescription="Capture"
            android:padding="10dp" />

        <View android:layout_width="0dp" android:layout_height="0dp" android:layout_weight="1" />

        <ImageButton android:id="@+id/btnFlipCamera"
            android:layout_width="52dp" android:layout_height="52dp"
            android:background="#22FFFFFF"
            android:src="@android:drawable/ic_menu_revert"
            android:tint="#AAFFFFFF"
            android:scaleType="center"
            android:contentDescription="Flip Camera" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
