<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- ── Camera Preview ─────────────────────────────────── -->
    <TextureView
        android:id="@+id/textureView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- ── Overlay (grid, focus ring, level) ──────────────── -->
    <com.adiopsweb.camera.ui.OverlayView
        android:id="@+id/overlayView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- ── Capture flash overlay ──────────────────────────── -->
    <View
        android:id="@+id/captureFlash"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#CCFFFFFF"
        android:alpha="0.8"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- ── Top Control Bar ────────────────────────────────── -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:background="#66000000"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <Button
            android:id="@+id/btnFlash"
            style="@style/Widget.AppCompat.Button.Borderless"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⚡"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:alpha="0.6"
            android:minWidth="0dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp" />

        <Button
            android:id="@+id/btnHdr"
            style="@style/Widget.AppCompat.Button.Borderless"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="HDR"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:alpha="0.6"
            android:minWidth="0dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp" />

        <Button
            android:id="@+id/btnGrid"
            style="@style/Widget.AppCompat.Button.Borderless"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⊞"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:alpha="0.6"
            android:minWidth="0dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp" />

        <Button
            android:id="@+id/btnRaw"
            style="@style/Widget.AppCompat.Button.Borderless"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="RAW"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:alpha="0.6"
            android:minWidth="0dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp" />

        <View android:layout_width="0dp" android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Recording indicator -->
        <View
            android:id="@+id/recordingIndicator"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:background="#FFFF0000"
            android:visibility="gone"
            android:layout_marginEnd="8dp" />

    </LinearLayout>

    <!-- ── Zoom Level Label ───────────────────────────────── -->
    <TextView
        android:id="@+id/tvZoomLevel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="1.0×"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:background="#66000000"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/topBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="8dp" />

    <!-- ── Pro Mode Panel ─────────────────────────────────── -->
    <ScrollView
        android:id="@+id/proPanel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:visibility="gone"
        android:background="#CC000000"
        app:layout_constraintTop_toBottomOf="@id/topBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <!-- ISO -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="8dp">
                <TextView android:layout_width="80dp" android:layout_height="wrap_content"
                    android:text="ISO" android:textColor="#FFFFFF" android:textSize="13sp" />
                <Spinner android:id="@+id/spinnerIso" android:layout_width="0dp"
                    android:layout_height="wrap_content" android:layout_weight="1"
                    android:backgroundTint="#FFFFFF" android:popupBackground="#333333" />
            </LinearLayout>

            <!-- Shutter -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="8dp">
                <TextView android:layout_width="80dp" android:layout_height="wrap_content"
                    android:text="Shutter" android:textColor="#FFFFFF" android:textSize="13sp" />
                <Spinner android:id="@+id/spinnerShutter" android:layout_width="0dp"
                    android:layout_height="wrap_content" android:layout_weight="1"
                    android:backgroundTint="#FFFFFF" android:popupBackground="#333333" />
            </LinearLayout>

            <!-- White Balance -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="8dp">
                <TextView android:layout_width="80dp" android:layout_height="wrap_content"
                    android:text="WB" android:textColor="#FFFFFF" android:textSize="13sp" />
                <Spinner android:id="@+id/spinnerWb" android:layout_width="0dp"
                    android:layout_height="wrap_content" android:layout_weight="1"
                    android:backgroundTint="#FFFFFF" android:popupBackground="#333333" />
            </LinearLayout>

            <!-- Focus Mode -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="8dp">
                <TextView android:layout_width="80dp" android:layout_height="wrap_content"
                    android:text="Focus" android:textColor="#FFFFFF" android:textSize="13sp" />
                <Spinner android:id="@+id/spinnerFocus" android:layout_width="0dp"
                    android:layout_height="wrap_content" android:layout_weight="1"
                    android:backgroundTint="#FFFFFF" android:popupBackground="#333333" />
            </LinearLayout>

            <!-- Manual Focus distance (visible only in MF) -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="8dp"
                android:visibility="gone" android:id="@+id/seekbarMfContainer">
                <TextView android:layout_width="80dp" android:layout_height="wrap_content"
                    android:text="MF Dist" android:textColor="#AAAAAA" android:textSize="12sp" />
                <SeekBar android:id="@+id/seekbarMf" android:layout_width="0dp"
                    android:layout_height="wrap_content" android:layout_weight="1"
                    android:progressTint="#FFFFFF" android:thumbTint="#FFFFFF"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- Exposure Compensation -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="8dp">
                <TextView android:layout_width="80dp" android:layout_height="wrap_content"
                    android:text="EV" android:textColor="#FFFFFF" android:textSize="13sp" />
                <SeekBar android:id="@+id/seekbarEv" android:layout_width="0dp"
                    android:layout_height="wrap_content" android:layout_weight="1"
                    android:progressTint="#FFD700" android:thumbTint="#FFD700" />
                <TextView android:id="@+id/tvEvValue" android:layout_width="40dp"
                    android:layout_height="wrap_content" android:text="0"
                    android:textColor="#FFD700" android:textSize="13sp"
                    android:gravity="center" />
            </LinearLayout>

            <!-- Color Profile -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical">
                <TextView android:layout_width="80dp" android:layout_height="wrap_content"
                    android:text="Profile" android:textColor="#FFFFFF" android:textSize="13sp" />
                <Spinner android:id="@+id/spinnerColorProfile" android:layout_width="0dp"
                    android:layout_height="wrap_content" android:layout_weight="1"
                    android:backgroundTint="#FFFFFF" android:popupBackground="#333333" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- ── Video Controls Panel ───────────────────────────── -->
    <LinearLayout
        android:id="@+id/videoControlsPanel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="#CC000000"
        android:padding="8dp"
        android:gravity="center_vertical"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/topBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Res:" android:textColor="#FFFFFF" android:textSize="13sp"
            android:paddingEnd="8dp" />
        <Spinner android:id="@+id/spinnerResolution" android:layout_width="0dp"
            android:layout_height="wrap_content" android:layout_weight="1"
            android:backgroundTint="#FFFFFF" android:popupBackground="#333333" />

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="  FPS:" android:textColor="#FFFFFF" android:textSize="13sp"
            android:paddingEnd="8dp" />
        <Spinner android:id="@+id/spinnerFps" android:layout_width="0dp"
            android:layout_height="wrap_content" android:layout_weight="1"
            android:backgroundTint="#FFFFFF" android:popupBackground="#333333" />

    </LinearLayout>

    <!-- ── Portrait Panel ─────────────────────────────────── -->
    <LinearLayout
        android:id="@+id/portraitPanel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="#CC000000"
        android:padding="12dp"
        android:gravity="center_vertical"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/topBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Bokeh" android:textColor="#FFFFFF" android:textSize="13sp"
            android:paddingEnd="12dp" />
        <SeekBar android:id="@+id/seekbarBokeh"
            android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:max="100" android:progress="50"
            android:progressTint="#00BFFF" android:thumbTint="#00BFFF" />

    </LinearLayout>

    <!-- ── Lens Selector ──────────────────────────────────── -->
    <LinearLayout
        android:id="@+id/lensSelector"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="#66000000"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        app:layout_constraintBottom_toTopOf="@id/modeTabBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="12dp">

        <Button
            android:id="@+id/btnLensUltrawide"
            style="@style/Widget.AppCompat.Button.Borderless"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:text="0.6×"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:alpha="0.6"
            android:minWidth="56dp" />

        <Button
            android:id="@+id/btnLensWide"
            style="@style/Widget.AppCompat.Button.Borderless"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:text="1×"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:alpha="1.0"
            android:minWidth="56dp" />

        <Button
            android:id="@+id/btnLensTele"
            style="@style/Widget.AppCompat.Button.Borderless"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:text="3×"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:alpha="0.6"
            android:minWidth="56dp" />

    </LinearLayout>

    <!-- ── Mode Tab Bar ───────────────────────────────────── -->
    <LinearLayout
        android:id="@+id/modeTabBar"
        android:layout_width="0dp"
        android:layout_height="44dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:background="#66000000"
        app:layout_constraintBottom_toTopOf="@id/bottomBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <Button
            android:id="@+id/tabPhoto"
            style="@style/Widget.AppCompat.Button.Borderless"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="PHOTO"
            android:textColor="#FFFFFF"
            android:textSize="11sp" />

        <Button
            android:id="@+id/tabVideo"
            style="@style/Widget.AppCompat.Button.Borderless"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="VIDEO"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:alpha="0.5" />

        <Button
            android:id="@+id/tabPortrait"
            style="@style/Widget.AppCompat.Button.Borderless"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="PORTRAIT"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:alpha="0.5" />

        <Button
            android:id="@+id/tabPro"
            style="@style/Widget.AppCompat.Button.Borderless"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="PRO"
            android:textColor="#FFD700"
            android:textSize="11sp"
            android:alpha="0.5" />

    </LinearLayout>

    <!-- ── Bottom Shutter Bar ─────────────────────────────── -->
    <LinearLayout
        android:id="@+id/bottomBar"
        android:layout_width="0dp"
        android:layout_height="100dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#CC000000"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Gallery thumbnail placeholder -->
        <ImageView
            android:id="@+id/ivGallery"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:background="#333333"
            android:scaleType="centerCrop"
            android:src="@android:drawable/ic_menu_gallery"
            android:contentDescription="Gallery" />

        <View android:layout_width="0dp" android:layout_height="0dp" android:layout_weight="1" />

        <!-- Shutter / Record button -->
        <ImageButton
            android:id="@+id/btnCapture"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:background="@drawable/shutter_button_bg"
            android:src="@android:drawable/ic_menu_camera"
            android:scaleType="center"
            android:contentDescription="Capture"
            android:padding="8dp" />

        <View android:layout_width="0dp" android:layout_height="0dp" android:layout_weight="1" />

        <!-- Flip camera (front / back) -->
        <ImageButton
            android:id="@+id/btnFlipCamera"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_rotate"
            android:tint="#FFFFFF"
            android:contentDescription="Flip Camera" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
